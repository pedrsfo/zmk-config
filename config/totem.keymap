#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        terminator: terminator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp PRINTSCREEN>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp LEFT_ALT &kp PRINTSCREEN>;

            label = "TERMINATOR";
        };

        killer: killer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp PRINTSCREEN>,
                <&macro_tap>,
                <&kp I>,
                <&macro_release>,
                <&kp LEFT_ALT &kp PRINTSCREEN>;

            label = "KILLER";
        };
    };

    behaviors {
        term_killer: term_killer {
            compatible = "zmk,behavior-mod-morph";
            label = "TERM_KILLER";
            bindings = <&terminator>, <&killer>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        esc_caps: esc_caps {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_CAPS";
            bindings = <&kp ESC>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        blue: blue {
            compatible = "zmk,behavior-tap-dance";
            label = "BLUE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt BT_SEL 0>, <&bt BT_SEL 1>, <&bt BT_SEL 2>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37 32 33 34>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 35 36 37>;
        };

        lt_custom: lt_custom {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_CUSTOM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        C_Word {
            bindings = <&caps_word>;
            key-positions = <13 16>;
        };

        C_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
           &kp Q            &kp W                &kp E                   &kp R              &kp T        &kp Y      &kp U                   &kp I              &kp O                 &kp P
           &hml LEFT_ALT A  &hml LEFT_CONTROL S  &hml LEFT_META D        &hml LEFT_SHIFT F  &kp G        &kp H      &hmr RIGHT_SHIFT J      &hmr RIGHT_META K  &hmr RIGHT_CONTROL L  &hmr RIGHT_ALT SLASH
&esc_caps  &kp Z            &kp X                &kp C                   &kp V              &kp B        &kp N      &kp M                   &kp COMMA          &kp PERIOD            &kp INT_RO            &kp LEFT_BRACKET
                                                 &lt 3 NON_US_BACKSLASH  &lt 2 TAB          &kp SPACE    &kp ENTER  &lt_custom 1 BACKSPACE  &kp DELETE
            >;
        };

        Sym {
            bindings = <
       &kp EXCL       &kp AT  &kp HASH  &kp DLLR   &kp LEFT_PARENTHESIS     &kp RIGHT_PARENTHESIS  &kp STAR              &kp MINUS  &kp EQUAL  &kp SQT
       &kp LS(GRAVE)  &none   &none     &kp PRCNT  &kp RBKT                 &kp BSLH               &mt RIGHT_SHIFT AMPS  &kp UNDER  &kp PLUS   &kp LS(APOS)
&none  &kp GRAVE      &none   &none     &none      &kp LS(RIGHT_BRACKET)    &kp LS(BSLH)           &none                 &none      &none      &none         &none
                              &trans    &trans     &trans                   &trans                 &trans                &trans
            >;
        };

        Num {
            bindings = <
       &none  &kp HOME  &kp UP              &kp END                &kp PAGE_UP      &kp PLUS   &kp N7                     &kp N8  &kp N9         &kp N0
       &none  &kp LEFT  &hml LEFT_WIN DOWN  &hml LEFT_SHIFT RIGHT  &kp PAGE_DOWN    &kp MINUS  &hmr RIGHT_SHIFT NUMBER_4  &kp N5  &hmr RCTRL N6  &none
&none  &none  &none     &none               &none                  &none            &kp STAR   &kp N1                     &kp N2  &kp N3         &none   &none
                        &trans              &trans                 &trans           &trans     &kp PERIOD                 &none
            >;
        };

        Fun {
            bindings = <
        &kp F2  &kp F3  &kp F4  &kp F5  &kp F6          &kp F7                &kp F8     &kp F9         &kp F10  &kp F11
        &trans  &trans  &trans  &trans  &blue           &kp C_BRI_INC         &kp PSCRN  &kp PAGE_UP    &trans   &kp LEFT_ALT
&kp F1  &none   &none   &none   &none   &bt BT_CLR      &kp C_BRIGHTNESS_DEC  &none      &kp PAGE_DOWN  &none    &none         &kp F12
                        &trans  &trans  &term_killer    &none                 &trans     &trans
            >;
        };
    };
};

